// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "button": false,
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "model": "gpt-6.1-sol",
      "provider": "openai-subscribed"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "threads_sidebar": {
      "auto_open": false,
      "position": "right"
    }
  },
  "agent_buffer_font_size": 16,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    }
  },
  "agent_ui_font_size": 20,
  "base_keymap": "VSCode",
  "buffer_font_fallbacks": [
    "Symbols Nerd Font Mono"
  ],
  "buffer_font_family": "Dank Mono",
  "buffer_font_size": 20,
  "cli_default_open_behavior": "existing_window",
  "colorize_brackets": true,
  "cursor_shape": "bar",
  "disable_ai": true,
  "edit_predictions": {
    "provider": "copilot"
  },
  "file_types": {
    "env": [
      ".env",
      ".env.*"
    ],
    "html": [
      "*.ejs.t",
      "*.t"
    ],
    "javascript": [
      "*.js"
    ]
  },
  "format_on_save": "on",
  "formatter": {
    "language_server": {
      "name": "xo"
    }
  },
  "git": {
    "diff_base": "head"
  },
  "git_panel": {
    "entry_primary_click_action": "file_diff",
    "group_by": "staging",
    "tree_view": true
  },
  "gutter": {
    "line_numbers": true
  },
  "hard_tabs": true,
  "icon_theme": {
    "dark": "Catppuccin Macchiato",
    "light": "Material Icon Theme",
    "mode": "dark"
  },
  "languages": {
    "JSON": {
      "formatter": "prettier"
    },
    "JSONC": {
      "formatter": "prettier"
    },
    "Markdown": {
      "formatter": "prettier"
    },
    "Terraform": {
      "formatter": "language_server"
    }
  },
  "lsp": {
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    },
    "xo": {
      "binary": {
        "arguments": [
          "/Users/spencer/Projects/xo-language-server/dist/src/cli.js",
          "--stdio"
        ],
        "path": "/Users/spencer/.local/bin/node"
      },
      "settings": {
        "xo": {
          "format": {
            "enable": true
          }
        }
      }
    }
  },
  "markdown_preview": {
    "limit_content_width": false
  },
  "minimap": {
    "display_in": "active_editor",
    "show": "always"
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "prettier": {
    "allowed": true,
    "jsonRecursiveSort": false,
    "jsonSortOrder": "{\"/.*/\": \"lexical\"}",
    "plugins": [
      "Users/spencer/.local/lib/node_modules/prettier-plugin-sort-json"
    ]
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
    "enabled": false
  },
  "project_panel": {
    "dock": "left"
  },
  "proxy": "",
  "relative_line_numbers": "enabled",
  "session": {
    "trust_all_worktrees": true
  },
  "show_edit_predictions": true,
  "show_whitespaces": "all",
  "soft_wrap": "none",
  "sticky_scroll": {
    "enabled": true
  },
  "tab_size": 2,
  "terminal": {
    "font_fallbacks": [
      "Symbols Nerd Font Mono"
    ],
    "font_family": "Dank Mono",
    "font_size": 18
  },
  "theme": {
    "dark": "Dracula",
    "light": "One Light",
    "mode": "dark"
  },
  "toolbar": {
    "agent_review": false,
    "code_actions": true
  },
  "ui_font_size": 20,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "vim_mode": true
}

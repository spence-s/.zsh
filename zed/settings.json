// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"git_panel": {
		"group_by": "none",
		"tree_view": true,
		"entry_primary_click_action": "file_diff",
	},
	"toolbar": {
		"agent_review": false,
		"code_actions": true,
	},
	"minimap": {
		"display_in": "active_editor",
		"show": "always",
	},
	"git": {
		"diff_base": "head",
	},
	"proxy": "",
	"disable_ai": true,
	"session": {
		"trust_all_worktrees": true,
	},
	"terminal": {
		"font_size": 18.0,
		"font_family": "Dank Mono",
		"font_fallbacks": ["Symbols Nerd Font Mono"],
	},
	"base_keymap": "VSCode",
	"preview_tabs": {
		"enabled": false,
		"enable_preview_from_file_finder": false,
	},
	"multi_cursor_modifier": "cmd_or_ctrl",
	"relative_line_numbers": "enabled",
	"gutter": {
		"line_numbers": true,
	},
	"cursor_shape": "bar",
	"buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
	"file_types": {
		"html": ["*.ejs.t", "*.t"],
		"javascript": ["*.js"],
		"env": [".env", ".env.*"],
	},
	"colorize_brackets": true,
	"show_whitespaces": "all",
	"show_edit_predictions": true,
	"soft_wrap": "none",
	"hard_tabs": true,
	"tab_size": 2,
	"cli_default_open_behavior": "existing_window",
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "Dracula",
	},
	"icon_theme": {
		"mode": "dark",
		"light": "Material Icon Theme",
		"dark": "Catppuccin Macchiato",
	},
	"agent_servers": {
		"pi-acp": {
			"type": "registry",
		},
		"github-copilot-cli": {
			"type": "registry",
		},
	},
	"agent": {
		"button": false,
		"threads_sidebar": {
			"auto_open": false,
			"position": "right",
		},
		"dock": "right",
		"default_model": {
			"provider": "openai-subscribed",
			"model": "gpt-6.1-sol",
			"enable_thinking": true,
			"effort": "medium",
		},
		"favorite_models": [],
		"model_parameters": [],
	},
	"vim": {
		"toggle_relative_line_numbers": true,
	},
	"sticky_scroll": {
		"enabled": true,
	},
	"buffer_font_family": "Dank Mono",
	"project_panel": {
		"dock": "left",
	},
	"edit_predictions": {
		"provider": "copilot",
	},
	"vim_mode": true,
	"ui_font_size": 20,
	"buffer_font_size": 20.0,
	"agent_ui_font_size": 20,
	"agent_buffer_font_size": 16,
	"format_on_save": "on",
	"formatter": {
		"language_server": {
			"name": "xo",
		},
	},
	"languages": {
		"JSON": {
			"formatter": "prettier",
		},
		"JSONC": {
			"formatter": "prettier",
		},
		"Markdown": {
			"formatter": "prettier",
		},
		"Terraform": {
			"formatter": "language_server",
		},
	},
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"updateImportsOnFileMove": {
						"enabled": "always",
					},
				},
				"javascript": {
					"updateImportsOnFileMove": {
						"enabled": "always",
					},
				},
			},
			"enable_lsp_tasks": true,
		},
		"xo": {
			"binary": {
				"path": "/Users/spencer/.local/bin/node",
				"arguments": [
					"/Users/spencer/Projects/xo-language-server/dist/src/cli.js",
					"--stdio",
				],
			},
			"settings": {
				"xo": {
					"format": {
						"enable": true,
					},
				},
			},
		},
	},
}
